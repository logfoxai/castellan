{
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2020",
    "moduleResolution": "node16",
    "module": "Node16",
    "declaration": true,
    "lib": ["ES2020"],
    "removeComments": false,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "sourceMap": true,
    "pretty": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitAny": true,
    "strict": true,
    "noImplicitReturns": false,
    "noImplicitUseStrict": false,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitHelpers": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ui",
    "src/**/*.spec.ts",
    "src/content.config.ts",
    "src/content/**",
    "src/components/**",
    "src/overrides/**",
    "src/pages/**",
    "src/integrations/**",
    "src/ui/**",
    "src/cs-pagefind/**"
  ]
}
