{
  "name": "castellan",
  "version": "0.0.0",
  "description": "Beta. Lightweight deployment control and monitoring for docker-compose. One sidecar — polls registries, rolling restarts with health verification, automatic rollback, and a built-in dashboard.",
  "keywords": [
    "docker",
    "docker-compose",
    "watchtower",
    "deployment",
    "ecr",
    "ghcr",
    "docker-hub",
    "rollback",
    "sidecar",
    "lightweight",
    "containers",
    "devops",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logfoxai/castellan.git"
  },
  "homepage": "https://castellan.logfox.ai",
  "directories": {
    "doc": "src/content/docs"
  },
  "license": "MIT",
  "author": "Marc H. Weiner <mhweiner234@gmail.com>",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && npm run build:ui",
    "build:ui": "npm run build -w ui",
    "build:compile": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "c8 kizu -f 'src/**/*.spec.ts' && c8 report -r text -r html",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "deadcode:check": "knip",
    "screenshots": "npm run build:ui && node scripts/capture-screenshots.mjs",
    "readme-lockup": "npm run build:ui && node scripts/capture-readme-lockup.mjs",
    "astro:sync": "astro sync",
    "astro:dev": "node scripts/clean-astro-cache.mjs && astro sync && astro dev",
    "astro:build": "node scripts/clean-astro-cache.mjs && astro sync && astro build && node scripts/write-cs-pagefind-shim.mjs",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "validate": "npm run build && npm run lint && npm run deadcode:check && npm test && npm run sync:fonts && npm run astro:build && node scripts/assert-404-page.mjs && node scripts/assert-splash-page.mjs"
  },
  "dependencies": {
    "dockerode": "4.0.12",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/starlight": "0.41.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@types/dockerode": "^4.0.1",
    "@types/express": "4.17.17",
    "@types/node": "25.5.0",
    "astro": "7.2.0",
    "c8": "11.0.0",
    "eslint": "10.0.2",
    "kizu": "5.1.0",
    "knip": "6.29.0",
    "phosphor-astro": "2.1.0",
    "playwright": "1.61.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "cookie": "2.0.1"
  }
}
