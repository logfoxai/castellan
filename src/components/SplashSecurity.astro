---
/**
 * Security beat — VPN-first access model.
 */
const providers = [
	{name: 'Tailscale', label: 'Tailscale'},
	{name: 'VPN', label: 'Private VPN'},
	{name: 'Internal DNS', label: 'Split DNS'},
] as const;
---

<section class="splash-section splash-band splash-auth" aria-labelledby="splash-security-title">
	<header class="splash-auth__intro">
		<h2 id="splash-security-title" class="splash-auth__title">Keep it on your private network</h2>
		<p class="splash-auth__lede">
			Castellan controls the Docker socket and can restart any labeled container. Never expose port
			3003 on the public internet — bind to Tailscale, reverse-proxy on your VPN interface, and use
			the shared API secret for defense in depth.
		</p>
	</header>

	<div class="splash-auth__works">
		<span class="splash-see">Designed for</span>
		<ul class="splash-auth__providers" aria-label="Access patterns">
			{
				providers.map(({name, label}) => (
					<li class="splash-auth__provider">
						<span class="splash-auth__text-badge">{label}</span>
					</li>
				))
			}
		</ul>
		<span class="splash-see">not public HTTP</span>
	</div>
</section>

<style>
	.splash-auth__text-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--cs-line);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--cs-ink);
		background: color-mix(in srgb, var(--sl-color-bg) 80%, transparent);
	}
</style>
