---
/**
 * Splash homepage icons — Phosphor marks for deploy/compose concepts.
 */
import ArrowCounterClockwise from 'phosphor-astro/ArrowCounterClockwise.astro';
import ArrowsLeftRight from 'phosphor-astro/ArrowsLeftRight.astro';
import LockOpen from 'phosphor-astro/LockOpen.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import Stack from 'phosphor-astro/Stack.astro';
import Tag from 'phosphor-astro/Tag.astro';
import TerminalWindow from 'phosphor-astro/TerminalWindow.astro';

export type SplashIconName =
	| 'compose'
	| 'shield'
	| 'rollback'
	| 'pipeline'
	| 'unlock'
	| 'label'
	| 'swap';

interface Props {
	name: SplashIconName;
}

const {name} = Astro.props;
const svgProps = {'aria-hidden': 'true' as const};
---

{
	name === 'compose' ? (
		<Stack {...svgProps} />
	) : name === 'shield' ? (
		<ShieldCheck {...svgProps} />
	) : name === 'rollback' ? (
		<ArrowCounterClockwise {...svgProps} />
	) : name === 'pipeline' ? (
		<TerminalWindow {...svgProps} />
	) : name === 'unlock' ? (
		<LockOpen {...svgProps} />
	) : name === 'label' ? (
		<Tag {...svgProps} />
	) : name === 'swap' ? (
		<ArrowsLeftRight {...svgProps} />
	) : null
}
